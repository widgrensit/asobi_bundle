%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-

%% A meta-package. It has no src/*.erl and never will: adding code here would
%% put it below asobi and above every extension in the dependency order, which
%% is the one place in the fleet nothing should live.

{erl_opts, [debug_info]}.

{deps, [
    {asobi, {git, "https://github.com/widgrensit/asobi.git", {branch, "main"}}},
    {asobi_quests, {git, "https://github.com/widgrensit/asobi_quests.git", {branch, "main"}}},
    {asobi_seasons, {git, "https://github.com/widgrensit/asobi_seasons.git", {branch, "main"}}}
]}.

{project_plugins, [
    {asobi, {git, "https://github.com/widgrensit/asobi.git", {branch, "main"}}},
    {erlfmt, "~>1.7"}
]}.

{hex, [
    {include_files, [
        <<"src">>,
        <<"rebar.config">>,
        <<"rebar.lock">>,
        <<"README.md">>
    ]}
]}.

{erlfmt, [
    write,
    {files, ["rebar.config", "src/*.app.src"]}
]}.
