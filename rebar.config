%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-

%% A meta-package. It has no src/*.erl and never will: adding code here would
%% put it below asobi and above every extension in the dependency order, which
%% is the one place in the fleet nothing should live.

{erl_opts, [debug_info]}.

%% Pinned to exact tags with a committed rebar.lock. The bundle asserts ONE
%% CI-verified row: this asobi minor plus these extension patches boot and
%% pass `rebar3 asobi check` together. It is never a compatibility matrix; when
%% asobi's minor moves, this whole row moves with it. (End-state, once all
%% three are on Hex: third-segment `~>` ranges, never positional `~> 0.83`.)
{deps, [
    {asobi, {git, "https://github.com/widgrensit/asobi.git", {tag, "v0.83.8"}}},
    {asobi_quests, {git, "https://github.com/widgrensit/asobi_quests.git", {tag, "v0.2.3"}}},
    {asobi_seasons, {git, "https://github.com/widgrensit/asobi_seasons.git", {tag, "v0.1.0"}}}
]}.

{project_plugins, [
    {asobi, {git, "https://github.com/widgrensit/asobi.git", {tag, "v0.83.8"}}},
    {erlfmt, "~>1.7"}
]}.

%% The bundle IS the official ghcr.io/widgrensit/asobi image (built by
%% docker-publish.yml, relocated here from the asobi repo). The release runs
%% asobi - the bundle contributes no code, only the extension closure - so the
%% config below is asobi's own config verbatim; asobi is the bootstrap_application.
{relx, [
    {release, {asobi_bundle, git}, [
        asobi_bundle,
        sasl
    ]},
    {mode, dev},
    {sys_config_src, "./config/dev_sys.config.src"},
    {vm_args_src, "./config/vm.args.src"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {sys_config_src, "./config/prod_sys.config.src"}
        ]}
    ]}
]}.

{hex, [
    {include_files, [
        <<"src">>,
        <<"config">>,
        <<"rebar.config">>,
        <<"rebar.lock">>,
        <<"README.md">>
    ]}
]}.

{erlfmt, [
    write,
    {files, ["rebar.config", "src/*.app.src"]}
]}.
